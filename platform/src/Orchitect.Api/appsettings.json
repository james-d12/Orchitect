{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtOptions": {
    "Issuer": "https://localhost:7545",
    "Audience": "https://localhost:7545",
    "ExpirationInMinutes": 10,
    "Secret": ""
  },
  "EncryptionOptions": {
    "Key": ""
  },
  "CorsSettings": {
    "AllowedFrontend": ""
  },
  "DiscoverySettings": {
    "IntervalMinutes": 30
  },
  "RunnerOptions": {
    "Image": "orchitect-runner:azure-terraform",
    "TerraformBackend": {
      "Mode": "Local"
    },
    "SecretProvider": {
      "Type": "Environment"
    },
    "Configuration": {}
  }
}
